{
  "name": "@wiggumdev/ralph",
  "version": "0.0.3",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ralph": "./src/ralph"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "build:single": "bun run script/build.ts --single",
    "dev": "bun run --watch src/index.ts",
    "install-bin": "bun run script/install.ts",
    "unlink": "bun run script/unlink.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "version": "bun run script/version.ts",
    "publish": "bun run script/publish.ts",
    "publish:npm": "bun run script/publish.ts --publish",
    "publish:dry-run": "bun run script/publish.ts --dry-run"
  },
  "imports": {
    "#commands/*": "./src/commands/*.ts",
    "#adapters/*": "./src/adapters/*.ts",
    "#config/*": "./src/config/*.ts",
    "#schema/*": "./src/schema/*.ts",
    "#hooks": "./src/hooks/index.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#ui/*": "./src/ui/*.tsx",
    "#ui/components/*": "./src/ui/components/*.tsx",
    "#ui/components/blocks/*": "./src/ui/components/blocks/*.tsx",
    "#utils/*": "./src/utils/*.ts",
    "#parsers": "./src/parsers/index.ts",
    "#parsers/*": "./src/parsers/*.ts",
    "#global": "./src/global.ts",
    "#log": "./src/log.ts"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@opentui/core": "^0.1.72",
    "@opentui/solid": "^0.1.72",
    "babel-preset-solid": "1.9.10",
    "diff": "^8.0.2",
    "partial-json": "^0.1.7",
    "smol-toml": "^1.6.0",
    "solid-js": "1.9.10",
    "xdg-basedir": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/yargs": "^17.0.35"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
