{
  "name": "@ralph/cli",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "ralph": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts"
  },
  "imports": {
    "#commands/*": [
      "./src/commands/*.ts"
    ],
    "#adapters/*": [
      "./src/adapters/*.ts"
    ],
    "#config/*": [
      "./src/config/*.ts"
    ],
    "#schema/*": [
      "./src/schema/*.ts"
    ],
    "#ui/*": [
      "./src/ui/*.tsx"
    ],
    "#utils/*": [
      "./src/utils/*.ts"
    ],
    "#global": [
      "./src/global.ts"
    ],
    "#log": [
      "./src/log.ts"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@opentui/core": "^0.1.69",
    "@opentui/solid": "^0.1.69",
    "babel-preset-solid": "1.9.9",
    "smol-toml": "^1.6.0",
    "solid-js": "1.9.9",
    "xdg-basedir": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.35"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
